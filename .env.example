# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
# Local:  postgresql://user:password@localhost:5432/crypto_sentinel
# Neon:   postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=""

# Bearer token protecting the cron and internal API routes (required)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALERT_API_KEY=""

# AES-256-GCM key used to encrypt Delta Exchange credentials at rest (required in production)
# Must be 32 bytes as a 64-character hex string.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this makes existing rows in `api_credentials` undecryptable.
ENCRYPTION_KEY=""

# bcryptjs hash gating dashboard access (optional — leave empty for no authentication)
# Generate: node -e "require('bcryptjs').hash('your-password', 10).then(h => console.log(h))"
APP_PASSWORD_HASH=""

# Enables the /api/ai/insights endpoint (optional)
ANTHROPIC_API_KEY=""

# ─────────────────────────────────────────────────────────────
# Optional — only needed when the cron pipeline cannot infer
# its own public base URL (i.e. outside `next dev` on localhost).
# On Vercel these are injected automatically.
# ─────────────────────────────────────────────────────────────
# APP_URL="https://sentinel.example.com"
# VERCEL_PROJECT_PRODUCTION_URL="sentinel.example.com"
# VERCEL_URL="sentinel-abc123.vercel.app"